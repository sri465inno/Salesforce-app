[
  {
    "title": "startDate after endDate is rejected",
    "type": "negative",
    "channel": "api",
    "mutation": {
      "endDate": {
        "$relative": "startDate",
        "days": -1
      }
    },
    "expected": {
      "success": false,
      "errorCode": "INVALID_DATE_RANGE"
    },
    "violates": [
      "startDate/endDate"
    ],
    "objective": "End date before start date must be rejected.",
    "flow": "create",
    "steps": [
      "Load the linked synthetic dataset",
      "Call the createReservation GraphQL mutation",
      "Assert success=false and error INVALID_DATE_RANGE"
    ],
    "id": "TC-001",
    "ruleIds": [
      "BR-001"
    ],
    "requirementIds": [
      "REQ-003",
      "REQ-011"
    ],
    "preconditions": [
      "Local demo reservation service is running",
      "Synthetic dataset DS-TC-001 is valid"
    ],
    "priority": "P2"
  },
