{
  "name": "salesforce-reservation-agentic-qe",
  "version": "0.1.0",
  "description": "Agentic Quality Engineering Platform MVP for a Salesforce-oriented reservation management application",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json",
    "start": "npm run build && node dist/src/platform/server.js",
    "start:demo-service": "npm run build && node dist/src/demo-service/server.js",
    "demo": "npm run build && node dist/scripts/demo.js",
    "artifacts": "npm run build && node dist/scripts/demo.js --artifacts-only",
    "reset": "npm run build && node dist/scripts/reset.js",
    "scan:secrets": "npm run build && node dist/scripts/scan-secrets.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "lint": "npm run typecheck && eslint .",
    "pretest": "npm run build",
    "test": "playwright test -c tests/playwright.config.ts",
    "record:source-refs": "npm run build && node dist/scripts/record-source-refs.js"
  },
  "dependencies": {
    "@playwright/test": "1.63.0",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "graphql": "16.14.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "eslint": "9.39.4",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
